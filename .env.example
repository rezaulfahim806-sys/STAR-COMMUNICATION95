PORT=10000
MONGODB_URI=mongodb+srv://USER:CHANGE_ME@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=star_communication
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
# Optional: use ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=$2a$...

# bKash Checkout - keep all credentials server-side
BKASH_BASE_URL=https://checkout.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=YOUR_BKASH_APP_KEY
BKASH_APP_SECRET=YOUR_BKASH_APP_SECRET
BKASH_USERNAME=YOUR_BKASH_USERNAME
BKASH_PASSWORD=YOUR_BKASH_PASSWORD
PUBLIC_URL=https://YOUR-BACKEND-DOMAIN
PAYMENT_PAGE_URL=https://rezaulfahim806-sys.github.io/STAR-COMMUNICATION95/pay.html

# Baniq Pay - keep all API credentials server-side; set the webhook URL in Baniq dashboard to https://YOUR-BACKEND-DOMAIN/api/baniq/webhook
BANIQ_API_BASE=https://api.baniq.app
BANIQ_KEY_ID=YOUR_BANIQ_KEY_ID
BANIQ_SECRET=YOUR_BANIQ_API_SECRET
BANIQ_WEBHOOK_SECRET=YOUR_BANIQ_WEBHOOK_SECRET

# SMS provider - keep API secret server-side
SMS_API_URL=https://YOUR-SMS-PROVIDER.example/api/send
SMS_API_KEY=YOUR_SMS_API_KEY
SMS_SENDER=STAR COMM
